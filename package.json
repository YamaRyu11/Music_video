{
  "name": "music-video-studio",
  "version": "0.9.0",
  "private": true,
  "description": "音楽から映像をつくる、ポータブルなオーディオリアクティブ動画メーカー",
  "author": "Music Video Studio contributors",
  "license": "MIT",
  "type": "module",
  "main": "desktop-dist/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/generate-demo.mjs && vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:desktop": "npm run build && node scripts/test-desktop.mjs",
    "test:new-styles": "npm run build && node scripts/test-new-styles.mjs",
    "test:wireframes": "npm run build && node scripts/test-new-styles.mjs --wireframes",
    "test:bitmap": "npm run build && node scripts/test-bitmap.mjs",
    "test:generative": "npm run build && node scripts/test-new-styles.mjs --generative",
    "test:layers": "npm run build && node scripts/test-layers.mjs",
    "dist:win": "npm run build && node scripts/prepare-windows.mjs && electron-builder --win zip --x64 --publish never"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/linux-x64": "4.1.0",
    "@ffmpeg-installer/win32-x64": "4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "tar": "^7.4.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "studio.musicvideo.app",
    "productName": "Music Video Studio",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "desktop-dist/**/*", "package.json", "!node_modules/**/*"],
    "extraResources": [
      { "from": ".cache/windows-ffmpeg/", "to": "tools", "filter": ["ffmpeg.exe", "LICENSE", "README.md", "package.json"] },
      { "from": "docs/PORTABLE.txt", "to": "PORTABLE.txt" },
      { "from": "docs/THIRD_PARTY.md", "to": "THIRD_PARTY.md" }
    ],
    "win": {
      "target": ["zip"],
      "signAndEditExecutable": false,
      "artifactName": "MusicVideoStudio-${version}-Windows-x64.zip"
    },
    "npmRebuild": false
  }
}
